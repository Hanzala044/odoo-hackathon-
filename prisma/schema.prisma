generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// SQLite does not support Prisma enums; values are validated in app code.
// Role: EMPLOYEE | HR | ADMIN
// AttendanceStatus: PRESENT | ABSENT | HALF_DAY | LEAVE
// LeaveType: PAID | SICK | UNPAID
// LeaveStatus: PENDING | APPROVED | REJECTED

model Company {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())
  users     User[]
  counters  JoinCounter[]
}

model JoinCounter {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  count     Int     @default(0)
  @@unique([companyId, year])
}

model User {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  email            String   @unique
  password         String
  role             String   @default("EMPLOYEE")
  mustChangePassword Boolean @default(false)
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  emailVerified    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile       Profile?
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
}

model Profile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  address       String?
  profilePic    String?
  jobTitle      String?
  department    String?
  manager       String?
  location      String?
  dateOfJoining DateTime?
  dateOfBirth   DateTime?
  nationality   String?
  gender        String?
  maritalStatus String?
  personalEmail String?
  bankAccount   String?
  bankName      String?
  ifscCode      String?
  panNo         String?
  uanNo         String?
  empCode       String?
  // SalaryInfo - auto-calculated from monthlyWage
  monthlyWage   Float     @default(50000)
  workingDaysPerWeek Int  @default(5)
  breakHours    Float     @default(1)
  salaryBase    Float     @default(0)
  salaryBonus   Float     @default(0)
  documents     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("PRESENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  startDate    DateTime
  endDate      DateTime
  remarks      String?
  status       String   @default("PENDING")
  adminComment String?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
